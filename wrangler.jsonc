{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callfocus",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/"],
    "not_found_handling": "single-page-application"
  }
}

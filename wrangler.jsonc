{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callfocus",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-04",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "CALLFOCUS_CONFIG",
      "id": "772f9544dbb7486480e876df3a7a7d3d"
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}

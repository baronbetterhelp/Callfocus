{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callfocus",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  "vars": {
    "CALLFOCUS_FROM_EMAIL": "CallFocus <accounts@callfocus.link>"
  },
  "secrets": {
    "required": [
      "CALLFOCUS_ADMIN_PASSCODE",
      "OPENAI_API_KEY",
      "PAYSTACK_SECRET_KEY",
      "RESEND_API_KEY",
      "RESEND_USAGE_API_KEY",
      "TAVUS_API_KEY",
      "POCKETFI_SECRET_KEY",
      "POCKETFI_PUBLIC_API_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "CALLFOCUS_CONFIG",
      "id": "772f9544dbb7486480e876df3a7a7d3d"
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/manual-payment-review",
      "/manual-payment-review/",
      "/admin",
      "/admin/",
      "/admin.css",
      "/admin.js",
      "/admin.html",
      "/404.html",
      "/about.html",
      "/avatar.html",
      "/image-video.html",
      "/callers.html",
      "/credits.html",
      "/index.html",
      "/privacy.html",
      "/profile.html",
      "/recent-calls.html",
      "/referrals.html",
      "/settings.html",
      "/support.html",
      "/terms.html",
      "/voice-notes.html",
      "/about",
      "/history",
      "/avatar",
      "/image-to-video",
      "/voice-notes",
      "/credits",
      "/referrals",
      "/callers",
      "/recent-calls",
      "/profile",
      "/settings",
      "/privacy",
      "/terms",
      "/support",
      "/"
    ],
    "not_found_handling": "404-page",
    "html_handling": "none"
  }
}

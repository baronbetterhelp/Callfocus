{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolcart",
  "main": "_worker.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toolcart",
      "database_id": "ef8f71eb-dd5a-41dd-b049-bfe85066aa98",
      "migrations_dir": "."
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "toolcart-media"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://toolcart.mgt-toolcart.workers.dev",
    "SESSION_TTL_DAYS": "30",
    "ALLOW_UNVERIFIED_SIGNUP": "true"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

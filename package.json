{
  "name": "toolcart",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check _worker.js && node --check app.js && node --check admin.js && node --check sw.js",
    "db:migrate:local": "wrangler d1 migrations apply toolcart --local",
    "db:migrate:remote": "wrangler d1 migrations apply toolcart --remote"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
